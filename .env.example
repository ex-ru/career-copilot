# ==============================================================================
# Career Copilot - Environment Configuration
# Скопируйте этот файл в .env и укажите настройки вашего AI-провайдера.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Вариант: OpenAI (ChatGPT)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-...
# LLM_MODEL=gpt-4o-mini  # или gpt-4o

# ------------------------------------------------------------------------------
# 2. Вариант: OpenRouter (универсальный шлюз ко всем моделям: Claude, DeepSeek, Gemini)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-sonnet

# ------------------------------------------------------------------------------
# 3. Вариант: Google Gemini (через OpenAI-совместимый эндпоинт Gemini API)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=AIzaSy...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 4. Вариант: Локальный бесплатный Ollama (100% приватность без API-ключей)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1  # или qwen2.5, deepseek-r1

# ------------------------------------------------------------------------------
# 5. Вариант: DeepSeek API
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Общие параметры
TEMPERATURE=0.3
MAX_TOKENS=4000
DEFAULT_LANGUAGE=both  # ru, en, both
